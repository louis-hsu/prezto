# Function to switch to neovim variants (except default nvim)
# Reference:
# https://gist.github.com/elijahmanor/b279553c0132bfad7eae23e34ceb593b
# https://michaeluloth.com/neovim-switch-configs/
# -- Louis 2023/1213
function _nvims() {
  local _items=$(fd --max-depth=1 --no-ignore 'nvim-' $XDG_CONFIG_HOME -x echo {/}) local _COLS=$(tput cols)

  if [ "${_COLS}" -ge 160 ]; then
    #popup tmux window
    local _fp="--tmux=center,50%,60%"
  else
    #no popup window
    local _fp="--wrap"
  fi

  local _selected=$(printf "%s\n" "${_items[@]}" | \
    fzf "${_fp}" \
      --cycle \
      --prompt="  Neovim Variants 󰄾 " \
      --preview="eza -aF \
      --group-directories-first \
      --color=always \
      --no-quotes \
      --ignore-glob=\"Icon?|.DS_Store|.git\" -T -L 2 $XDG_CONFIG_HOME/{}")

  if [[ -z "${_selected}" ]]; then
    return 0
  elif [[ "${_selected}" == "nvim" ]]; then
    _selected=""
  fi
  NVIM_APPNAME="${_selected}" nvim "$@"
}

# Create aliases for different nvim distros dynamically
# -- Louis 2023/1213
function _create_nvimalias() {
  local _items=("${(@f)$(fd --max-depth=1 --no-ignore 'nvim-' $XDG_CONFIG_HOME -x echo {/})}")

  for _na in ${_items}; do
    if [[ "${_na}" != "nvim" ]]; then
      alias "${_na}"="NVIM_APPNAME=\"${_na}\" nvim"
    fi
  done
}
_create_nvimalias

# Sync 'package_delta.toml' from 'package.toml' in the yazi config dir.
# Strips all fields except section headers and 'use', producing a
# version-trackable file that captures intent without volatile rev/hash data.
# -- Louis 2026/0325
function _ya_sync_delta() {
  local _cfg="${XDG_CONFIG_HOME:-$HOME/.config}/yazi"
  local _src="$_cfg/package.toml"
  local _dst="$_cfg/package_delta.toml"

  if [[ ! -f "$_src" ]]; then
    echo "ya: warning: $_src not found, skipping delta sync" >&2
    return 1
  fi

  awk '
    /^\[\[plugin\.deps\]\]/ { if (need_blank) printf "\n"; print; need_blank=0; in_block=1; next }
    /^\[\[flavor\.deps\]\]/ { if (need_blank) printf "\n"; print; need_blank=0; in_block=1; next }
    in_block && /^use[[:space:]]*=/ { print; need_blank=1; next }
    in_block && /^(rev|hash)[[:space:]]*=/ { next }
  ' "$_src" >| "$_dst"
}

# Wrapper for 'ya' (yazi CLI) that keeps 'package_delta.toml' in sync.
#
# For mutating subcommands (pkg add/delete/upgrade/install), after the real
# 'ya' succeeds, package_delta.toml is regenerated from package.toml,
# preserving only 'use' fields — suitable for version tracking.
#
# Bootstrap flow (pkg install, package.toml absent, package_delta.toml present):
#   1. Clear plugins/ and flavors/ dirs
#   2. Copy package_delta.toml → package.toml
#   3. Run 'ya pkg install' (ya populates rev/hash)
#   4. Sync delta from the updated package.toml
#
# -- Louis 2026/0325
function ya() {
  local _cfg="${XDG_CONFIG_HOME:-$HOME/.config}/yazi"
  local _pkg="$_cfg/package.toml"
  local _delta="$_cfg/package_delta.toml"

  # Identify if this is a mutating pkg subcommand
  local _mutating=0
  if [[ "$1" == "pkg" ]]; then
    case "$2" in
      add|delete|upgrade|install) _mutating=1 ;;
    esac
  fi

  # Bootstrap: pkg install with no package.toml but package_delta.toml exists
  if [[ "$1" == "pkg" && "$2" == "install" && ! -f "$_pkg" ]]; then
    if [[ ! -f "$_delta" ]]; then
      echo "ya: error: neither package.toml nor package_delta.toml found in $_cfg" >&2
      return 1
    fi

    echo "ya: package.toml absent — bootstrapping from package_delta.toml" >&2

    # Clear stale plugin/flavor dirs
    [[ -d "$_cfg/plugins" ]] && rm -rf "$_cfg/plugins"
    [[ -d "$_cfg/flavors" ]] && rm -rf "$_cfg/flavors"

    # Seed package.toml from delta (ya will fill in rev/hash on install)
    cp "$_delta" "$_pkg"
  fi

  command ya "$@"
  local _exit=$?

  # Post-step: sync delta on success of any mutating command
  if [[ $_mutating -eq 1 && $_exit -eq 0 ]]; then
    _ya_sync_delta
  fi

  return $_exit
}
# For zsh completion
compdef _ya ya

# Function to enable 'yazi'
# (https://yazi-rs.github.io/docs/quick-start)
# -- Louis 2025/1230
function yy() {
	local tmp="$(mktemp -t "yazi-cwd.XXXXXX")" cwd
	command yazi "$@" --cwd-file="$tmp"
	IFS= read -r -d '' cwd < "$tmp"
	[ -n "$cwd" ] && [ "$cwd" != "$PWD" ] && builtin cd -- "$cwd"
	rm -f -- "$tmp"
}

