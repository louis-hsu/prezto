#
# Executes commands at login pre-zshrc.
#
# ------------------------ Script

# ------------------------ Browser
if [[ -z "$BROWSER" && "$OSTYPE" == darwin* ]]; then
  export BROWSER='open'
fi

# ------------------------ Editors
if [[ -z "$EDITOR" ]]; then
  export EDITOR='nvim'
fi
if [[ -z "$VISUAL" ]]; then
  export VISUAL='nvim'
fi
if [[ -z "$PAGER" ]]; then
  export PAGER='less'
fi

# ------------------------ Language
if [[ -z "$LANG" ]]; then
  export LANG='en_US.UTF-8'
fi

# ------------------------ Android
export ANDROID_HOME=$HOME/Library/Android/sdk
export ANDROID_USER_HOME=$HOME/.dotfiles/dot-android

# ------------------------ Path
eval "$(/opt/homebrew/bin/brew shellenv)"         # New brew configuration
export HOMEBREW_NO_ASK=1                          # Default yes to upgrade
export HOMEBREW_UPGRADE_GREEDY=1                  # Default yes to cask upgrade
typeset -gU cdpath fpath mailpath path            # Ensure path arrays do not contain duplicates.

# Set the list of directories that Zsh searches for programs.
path=(
  $HOME/.{,s}bin(N)                               # My utility tools -- Louis 2022/1011
  $HOME/.cargo/bin                                # Moved from zshenv -- Louis 2023-06-05 14:19
  $HOME/.docker/bin                               # Docker CLI folder -- Louis 2023/0620
  $ANDROID_HOME/tools                	            # Android SDK path -- Louis 2011/0420
  $ANDROID_HOME/platform-tools
  $HOMEBREW_PREFIX/opt/ruby/bin
  $HOMEBREW_PREFIX/opt/coreutils/libexec/gnubin   # Install gnu version coreutilis -- Louis 2015/0209
  $HOMEBREW_PREFIX/opt/gnu-getopt/bin             # Install gnu version getopt -- Louis 2020/1112
  $HOMEBREW_PREFIX/opt/sqlite/bin                 # Update brew sqlite location
  $HOMEBREW_PREFIX/opt/grep/libexec/gnubin        # Install gnu version grep  -- Louis 2021/0119
  $HOMEBREW_PREFIX/opt/gnu-time/libexec/gnubin    # Install gnu version time -- Louis 2021/0530
  $HOMEBREW_PREFIX/opt/gnu-sed/libexec/gnubin     # Install gnu version sed -- Louis 2024/0307
  $HOMEBREW_PREFIX/opt/ncurses/bin                # Install gnu version text-based UI library -- Louis 2024/1119
  $HOMEBREW_PREFIX/opt/findutils/libexec/gnubin   # Install gnu version find/xargs/locate utilis -- Louis 2026/0720
  /opt/{homebrew,local}/{,s}bin(N)
  $HOME/.dotfiles/dot-local/bin                   #Created by `pipx` on 2024-11-01 07:30:06
  /usr/local/{,s}bin(N)
  $path
)

# ------------------------ Less
# Set the default Less options.
if [[ -z "$LESS" ]]; then
  export LESS='-F -g -i -M -R -j4 -w -X'
fi

# Set the Less input preprocessor.
# Try both `lesspipe` and `lesspipe.sh` as either might exist on a system.
if [[ -z "$LESSOPEN" ]] && (( $#commands[(i)lesspipe(|.sh)] )); then
  export LESSOPEN="| /usr/bin/env $commands[(i)lesspipe(|.sh)] %s 2>&-"
fi

# ------------------------ Colors
export LS_COLORS="$(vivid generate $XDG_CONFIG_HOME/vivid/catppuccin-flatwhite)"    # Use 'vivid' to generate customized LS-COLORS and filetype

# Tell 'eza' to use LS_COLORS via 'reset' command and specify exa specific extra coloring
# Reference:
# https://the.exa.website/docs/colour-themes
# https://www.ditig.com/publications/256-colors-cheat-sheet (256 color)
GREY_COLOR='38;5;248'
GREY_COLOR_2='38;5;240'
GREY_COLOR_3='38;5;243'
export EXA_COLORS="uu=${GREY_COLOR_3}:\
un=${GREY_COLOR_3}:\
gu=${GREY_COLOR_3}:\
gn=${GREY_COLOR_3}:\
ur=33:\
uw=31:\
ue=32:\
ux=32:\
da=${GREY_COLOR_3}"

export GREP_COLORS='mt=38;5;232;48;2;136;192;208:ln=01;38;5;222'    # Configure grep color

# ------------------------ Fzf
FZF_COLORS="fg:#D8DEE9,\
fg+:#D8DEE9,\
bg+:#434C5E,\
hl:#EBCB8B,\
hl+:#EBCB8B,\
pointer:#BF616A,\
info:#B48EAD,\
spinner:#4C566A,\
header:#B48EAD,\
prompt:#81A1C1,\
marker:#A3BE8C"

export FZF_DEFAULT_OPTS="--style full\
 --height 80%\
 --reverse\
 --multi\
 --border\
 --color $FZF_COLORS\
 --bind 'tab:toggle+down,shift-tab:up+toggle'\
 --bind 'ctrl-up:preview-page-up,ctrl-down:preview-page-down'\
 --bind 'ctrl-u:page-up,ctrl-d:page-down'\
 --bind 'ctrl-y:execute-silent(echo -n {} | pbcopy)+abort'\
 --bind 'focus:transform-header:file --brief {}'"

export FZF_CTRL_T_COMMAND='fd -t f -H -L --color=always'
export FZF_CTRL_T_OPTS='--ansi --preview "bat -f {}"'
export FZF_CTRL_R_OPTS='--reverse'

export FZF_TMUX_OPTS='-p -w 85% -h 80%'

# ------------------------ Bat (better cat)
# Use 'bat' to better colorize manpage -- Louis 2023-04-11 15:08
export MANPAGER='sh -c "col -bx | bat -l man -p --theme="Monokai Extended""'
export MANROFFOPT='-c'

# ------------------------ Others
export RIPGREP_CONFIG_PATH="${XDG_CONFIG_HOME}/ripgrep/ripgreprc"
export DELTA_FEATURES='nshiu_nordbase zebra-dark' # Add for 'core.pager' setup in 'git/config'
export GEM_HOME=~/.gem                            # Setup gem home/binary path

# Virtualenv
export VIRTUALENVWRAPPER_PYTHON="$(which python3)"
export WORKON_HOME="$HOME/.virtualenvs"
export PROJECT_HOME="$HOME/Development/PythonDev"
export VIRTUALENVWRAPPER_WORKON_CD=1

# Set terminal parameter
export COLORTERM=truecolor
export TERM=screen-256color-italic

